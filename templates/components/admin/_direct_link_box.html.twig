{# Encart lien direct sécurisé (à placer HORS du <form> principal pour éviter les formulaires imbriqués) #}
{# Variables attendues : shareUrl, regenerateUrl, label (ex. "cet article", "cette collection", "cette catégorie") #}
<div class="card p-6 mt-6 border border-amber-200 bg-amber-50/50">
    <div class="flex items-start justify-between gap-4 mb-3">
        <div>
            <h3 class="font-heading text-lg font-bold text-amber-900 flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                </svg>
                Lien direct privé
            </h3>
            <p class="text-xs text-amber-800 mt-0.5">
                Seules les personnes disposant de ce lien (ou d'un lien de niveau supérieur) peuvent voir et commander {{ label }}.
            </p>
        </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-2">
        <input type="text" readonly value="{{ shareUrl }}" class="form-input bg-white text-sm font-mono flex-1 select-all">
        <button type="button"
                data-copy-link="{{ shareUrl }}"
                class="btn-primary text-sm whitespace-nowrap inline-flex items-center justify-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            Copier le lien
        </button>
    </div>

    <div class="mt-3 flex items-center justify-between gap-4">
        <a href="{{ shareUrl }}" target="_blank" rel="noopener" class="text-xs text-primary hover:underline">
            Ouvrir le lien dans un nouvel onglet ↗
        </a>
        <form method="post" action="{{ regenerateUrl }}" data-confirm="Régénérer le lien direct ? L'ancien lien ne fonctionnera plus.">
            {% include 'components/_csrf.html.twig' %}
            <button type="submit" class="text-xs text-amber-800 hover:text-red-700 underline">
                Régénérer le lien (invalider l'ancien)
            </button>
        </form>
    </div>
</div>
