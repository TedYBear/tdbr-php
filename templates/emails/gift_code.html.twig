{% extends 'emails/base.html.twig' %}

{% block header_title %}{{ campagneNom|default('Un cadeau pour vous !') }}{% endblock %}

{% block content %}
    <h2 style="color: #9E5A2A; margin-top: 0;">Merci pour votre commande !</h2>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Votre soutien compte énormément pour nous. Pour vous remercier d'avoir fait confiance à TDBR,
        voici votre bon d'achat à utiliser sur votre prochaine commande :
    </p>

    <div style="background-color: #FAF3EB; padding: 28px; border-radius: 12px; margin: 28px 0; text-align: center;">
        <div style="font-size: 13px; color: #9E5A2A; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 12px; font-weight: 600;">
            Votre bon d'achat
        </div>
        <div style="font-size: 2rem; font-weight: 800; color: #3D2617; letter-spacing: 0.15em; font-family: monospace; background: #fff; display: inline-block; padding: 12px 28px; border-radius: 8px; border: 2px dashed #DE9B52;">
            {{ code }}
        </div>
        <div style="margin-top: 16px; font-size: 18px; font-weight: 700; color: #9E5A2A;">
            {{ montant|number_format(2, ',', ' ') }} € de bon d'achat
        </div>
        {% if dateExpiration is defined and dateExpiration %}
            <div style="margin-top: 8px; font-size: 13px; color: #753E1B;">
                Valable jusqu'au <strong>{{ dateExpiration|date('d/m/Y') }}</strong>
            </div>
        {% endif %}
    </div>

    <p style="font-size: 14px; line-height: 1.6; color: #666;">
        Ce bon d'achat est valable pour une utilisation sur votre prochaine commande{% if dateExpiration is defined and dateExpiration %} jusqu'au {{ dateExpiration|date('d/m/Y') }}{% endif %}.
        Vous le retrouverez automatiquement dans votre espace client et lors du passage en caisse.
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333; font-weight: 600; margin-top: 32px;">
        À très bientôt !<br>
        L'équipe TDBR
    </p>
{% endblock %}
