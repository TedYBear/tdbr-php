{% extends 'emails/base.html.twig' %}

{% block header_title %}Votre facture acquittée{% endblock %}

{% block content %}
    <h2 style="color: #143027; margin-top: 0;">Paiement reçu — merci !</h2>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Bonjour <strong>{{ commande.client.prenom ?? '' }} {{ commande.client.nom ?? '' }}</strong>,
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Nous avons bien reçu votre paiement. Vous trouverez ci-joint la facture acquittée
        de votre commande <strong>{{ commande.numero }}</strong>.
    </p>

    <div style="background-color: #E7F4EE; padding: 20px; border-radius: 8px; margin: 20px 0;">
        <table style="width: 100%; font-size: 14px; color: #333;">
            <tr>
                <td style="padding: 4px 0; color: #666;">Numéro de commande</td>
                <td style="padding: 4px 0; text-align: right; font-weight: 600;">{{ commande.numero }}</td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #666;">Date</td>
                <td style="padding: 4px 0; text-align: right;">{{ commande.createdAt|date('d/m/Y') }}</td>
            </tr>
            <tr>
                <td style="padding: 4px 0; color: #666; border-top: 1px solid #4FB48A; padding-top: 12px; font-weight: 700; font-size: 16px;">Total payé</td>
                <td style="padding: 4px 0; text-align: right; border-top: 1px solid #4FB48A; padding-top: 12px; font-weight: 700; font-size: 16px; color: #2F7A5B;">{{ commande.total|number_format(2, ',', ' ') }} €</td>
            </tr>
        </table>
    </div>

    <p style="font-size: 14px; line-height: 1.6; color: #666; margin-top: 20px;">
        Si vous avez des questions concernant cette commande, n'hésitez pas à nous contacter.
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333; font-weight: 600; margin-top: 30px;">
        À bientôt !<br>
        L'équipe TDBR
    </p>
{% endblock %}
