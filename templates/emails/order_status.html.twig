{% extends 'emails/base.html.twig' %}

{% block header_title %}Mise à jour de commande{% endblock %}

{% block content %}
    <h2 style="color: #243B1E; margin-top: 0;">Mise à jour de votre commande</h2>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Bonjour <strong>{{ commande.client.prenom ?? '' }}</strong>,
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Le statut de votre commande <strong>{{ commande.numero }}</strong> a été mis à jour :
    </p>

    <div style="background-color: #FAF1D8; padding: 25px; border-radius: 8px; margin: 20px 0; text-align: center;">
        <div style="font-size: 24px; font-weight: bold; color: #4F8A3D; margin-bottom: 10px;">
            {% if newStatus == 'validee' %}
                ✓ Commande Validée
            {% elseif newStatus == 'en_production' %}
                🔨 En cours de préparation
            {% elseif newStatus == 'expediee' %}
                📦 Commande Expédiée
            {% elseif newStatus == 'livree' %}
                ✓ Commande Livrée
            {% elseif newStatus == 'annulee' %}
                ✗ Commande Annulée
            {% else %}
                {{ statusLabel }}
            {% endif %}
        </div>

        {% if newStatus == 'expediee' %}
            <p style="font-size: 14px; color: #666; margin-top: 15px;">
                Votre colis est en route ! Vous devriez le recevoir sous 2 à 3 jours ouvrés.
            </p>
        {% elseif newStatus == 'livree' %}
            <p style="font-size: 14px; color: #666; margin-top: 15px;">
                Nous espérons que vous êtes satisfait(e) de votre achat ! N'hésitez pas à nous faire part de vos impressions.
            </p>
        {% elseif newStatus == 'en_production' %}
            <p style="font-size: 14px; color: #666; margin-top: 15px;">
                Nous préparons votre commande avec le plus grand soin. Elle sera bientôt prête pour l'expédition.
            </p>
        {% endif %}
    </div>

    <div style="text-align: center; margin: 30px 0;">
        <a href="http://localhost:8000/confirmation/{{ commande._id }}" class="button">
            Voir ma commande
        </a>
    </div>

    <p style="font-size: 14px; line-height: 1.6; color: #666; margin-top: 30px;">
        Si vous avez des questions concernant votre commande, n'hésitez pas à nous contacter.
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333; font-weight: 600;">
        Cordialement,<br>
        L'équipe TDBR
    </p>
{% endblock %}
