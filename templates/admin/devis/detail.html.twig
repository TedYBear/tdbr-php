{% extends 'admin/base_admin.html.twig' %}

{% block title %}Demande #{{ devis.id }}{% endblock %}
{% block page_title %}Demande sur-mesure de {{ devis.nom }}{% endblock %}
{% block page_subtitle %}<p class="text-sm text-gray-500 mt-1">Reçu le {{ devis.createdAt|date('d/m/Y à H:i') }}</p>{% endblock %}

{% block body %}
    <div class="mb-6">
        <a href="{{ path('admin_devis') }}" class="inline-flex items-center gap-2 text-gray-600 hover:text-primary transition text-sm">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
            </svg>
            Retour aux demandes
        </a>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
        {# Infos principales #}
        <div class="lg:col-span-2 space-y-6">

            {# Contact #}
            <div class="card p-6">
                <h2 class="font-heading text-xl font-bold mb-4">Coordonnées</h2>
                <div class="grid sm:grid-cols-2 gap-4 text-sm">
                    <div><span class="text-gray-500">Nom :</span> <span class="font-semibold">{{ devis.nom }}</span></div>
                    <div><span class="text-gray-500">Email :</span> <a href="mailto:{{ devis.email }}" class="text-primary">{{ devis.email }}</a></div>
                    {% if devis.telephone %}
                        <div><span class="text-gray-500">Téléphone :</span> <span>{{ devis.telephone }}</span></div>
                    {% endif %}
                    <div><span class="text-gray-500">Contact préféré :</span> <span class="capitalize">{{ devis.moyenContact }}</span></div>
                    <div>
                        <span class="text-gray-500">Origine :</span>
                        {% if devis.source == 'fiche_produit' %}
                            <span class="px-2 py-0.5 bg-purple-100 text-purple-700 rounded text-xs font-medium">Fiche produit</span>
                        {% else %}
                            <span class="px-2 py-0.5 bg-gray-100 text-gray-600 rounded text-xs font-medium">Devis générique</span>
                        {% endif %}
                    </div>
                    <div>
                        <span class="text-gray-500">Compte :</span>
                        {% if devis.user %}
                            <span class="font-semibold">{{ devis.user.fullName ?: devis.user.email }}</span>
                            <span class="text-gray-400">(#{{ devis.user.id }})</span>
                        {% else %}
                            <span class="text-amber-600">Invité (non connecté)</span>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Produit & personnalisation (demande depuis une fiche produit) #}
            {% if devis.source == 'fiche_produit' %}
                <div class="card p-6">
                    <h2 class="font-heading text-xl font-bold mb-4">Produit & personnalisation</h2>
                    {% if devis.article %}
                        <div class="mb-4 text-sm">
                            <span class="text-gray-500">Produit :</span>
                            <a href="{{ path('article_detail', {slug: devis.article.slug}) }}" target="_blank" class="font-semibold text-primary">{{ devis.article.nom }}</a>
                            <span class="text-gray-400">(#{{ devis.article.id }})</span>
                        </div>
                    {% else %}
                        <p class="text-sm text-amber-600 mb-4">Produit supprimé depuis.</p>
                    {% endif %}
                    {% if devis.personnalisation and devis.personnalisation.type is defined %}
                        <div class="text-sm"><span class="text-gray-500">Type de demande :</span> <span class="font-semibold">{{ devis.personnalisation.type }}</span></div>
                    {% elseif devis.personnalisation %}
                        {% set p = devis.personnalisation %}
                        <div class="grid sm:grid-cols-2 gap-3 text-sm">
                            <div><span class="text-gray-500">Modèle :</span> <span class="font-semibold">{{ p.modele ?: '—' }}</span></div>
                            <div><span class="text-gray-500">Couleur :</span> <span class="font-semibold">{{ p.couleur ?: '—' }}</span></div>
                            <div><span class="text-gray-500">Taille :</span> <span class="font-semibold">{{ p.taille ?: '—' }}</span></div>
                            {% if p.autre %}<div><span class="text-gray-500">Autre :</span> <span class="font-semibold">{{ p.autre }}</span></div>{% endif %}
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# Projet (devis générique) #}
            {% if devis.concept %}
                <div class="card p-6">
                    <h2 class="font-heading text-xl font-bold mb-4">Description du projet</h2>
                    <p class="text-gray-700 whitespace-pre-line">{{ devis.concept }}</p>
                    {% if devis.contexte %}
                        <div class="mt-4 pt-4 border-t">
                            <div class="text-sm font-semibold text-gray-600 mb-1">Contexte :</div>
                            <p class="text-gray-700">{{ devis.contexte }}</p>
                        </div>
                    {% endif %}
                </div>
            {% endif %}

            {# Supports & Quantité #}
            <div class="card p-6">
                <h2 class="font-heading text-xl font-bold mb-4">Supports & Quantité</h2>
                {% if devis.supports|length > 0 %}
                    <div class="mb-3">
                        <div class="text-sm font-semibold text-gray-600 mb-2">Supports souhaités :</div>
                        <div class="flex flex-wrap gap-2">
                            {% for s in devis.supports %}
                                <span class="px-3 py-1 bg-accent text-primary rounded-full text-sm font-medium">{{ s }}</span>
                            {% endfor %}
                            {% if devis.autreSupport %}
                                <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">{{ devis.autreSupport }}</span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
                <div class="text-sm">
                    <span class="text-gray-500">Quantité :</span>
                    <span class="font-semibold ml-2">{{ devis.quantite }}</span>
                </div>
            </div>

            {% if devis.messageAdditionnel %}
                <div class="card p-6">
                    <h2 class="font-heading text-xl font-bold mb-4">Message complémentaire</h2>
                    <p class="text-gray-700 whitespace-pre-line">{{ devis.messageAdditionnel }}</p>
                </div>
            {% endif %}
        </div>

        {# Sidebar : gestion #}
        <div class="space-y-6">
            {# Statut actuel #}
            <div class="card p-6">
                <h2 class="font-heading text-xl font-bold mb-4">Statut actuel</h2>
                <div class="mb-4">
                    {% include 'admin/devis/_badge_statut.html.twig' with {statut: devis.statut} %}
                </div>

                <form method="post" action="{{ path('admin_devis_statut', {id: devis.id}) }}" class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Changer le statut</label>
                        <select name="statut" class="form-input">
                            <option value="nouveau" {{ devis.statut == 'nouveau' ? 'selected' : '' }}>Nouveau</option>
                            <option value="en_production" {{ devis.statut == 'en_production' ? 'selected' : '' }}>En production</option>
                            <option value="envoye" {{ devis.statut == 'envoye' ? 'selected' : '' }}>Réponse envoyée</option>
                            <option value="accepte" {{ devis.statut == 'accepte' ? 'selected' : '' }}>Accepté</option>
                            <option value="refuse" {{ devis.statut == 'refuse' ? 'selected' : '' }}>Refusé</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Notes internes</label>
                        <textarea name="notesAdmin" rows="4" class="form-input" placeholder="Notes visibles uniquement par l'admin...">{{ devis.notesAdmin }}</textarea>
                    </div>
                    <button type="submit" class="btn-primary w-full">Enregistrer</button>
                </form>
            </div>

            {# Proposition commerciale #}
            <div class="card p-6">
                <h2 class="font-heading text-xl font-bold mb-4">Proposition commerciale</h2>
                <a href="{{ path('admin_propositions_new', {devis: devis.id}) }}"
                   class="btn-primary w-full text-center block">
                    Créer une proposition
                </a>
                <p class="text-xs text-gray-500 mt-2">Décrire le contenu, fixer le prix et envoyer par email au client.</p>
            </div>

            {# Répondre #}
            <div class="card p-6">
                <h2 class="font-heading text-xl font-bold mb-4">Répondre</h2>
                <a href="mailto:{{ devis.email }}?subject=Votre demande sur-mesure TDBR"
                   class="btn-outline w-full text-center block">
                    Envoyer un email
                </a>
            </div>

            {# Supprimer #}
            <form method="post" action="{{ path('admin_devis_delete', {id: devis.id}) }}"
                  onsubmit="window.confirmForm(event, this, 'Supprimer définitivement cette demande ?')">
                <button type="submit" class="w-full px-4 py-2 text-red-600 border border-red-200 rounded-lg hover:bg-red-50 transition text-sm">
                    Supprimer cette demande
                </button>
            </form>
        </div>
    </div>
{% endblock %}
