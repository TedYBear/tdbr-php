{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ template ? 'Modifier' : 'Nouveau' }} Template{% endblock %}

{% block page_title %}{{ template ? 'Modifier' : 'Nouveau' }} Template{% endblock %}

{% block body %}
<form method="post" enctype="multipart/form-data" class="max-w-2xl">
    <div class="space-y-6">
        {# Informations de base #}
        <div class="card p-6">
            <h2 class="text-xl font-bold mb-4">Informations</h2>

            <div class="space-y-4">
                <div class="form-group">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nom *</label>
                    <input type="text"
                           name="nom"
                           value="{{ template ? template.nom : '' }}"
                           required
                           placeholder="ex : Vêtement taille/couleur, Peluche personnalisée..."
                           class="form-input">
                </div>

                <div class="form-group">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
                    <textarea name="description"
                              rows="3"
                              placeholder="Description optionnelle du template..."
                              class="form-textarea">{{ template and template.description is defined ? template.description : '' }}</textarea>
                </div>

                <div class="form-group">
                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                        Guide des tailles (PDF)
                        <span class="text-xs text-gray-400 font-normal">(optionnel)</span>
                    </label>

                    {# PDF déjà uploadé : aperçu + option de suppression #}
                    {% if template and template.guideTaillePdfUrl %}
                        <div class="flex items-center gap-3 p-3 mb-3 bg-gray-50 border border-gray-200 rounded-lg">
                            <svg class="w-5 h-5 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            <a href="{{ template.guideTaillePdfUrl }}" target="_blank" rel="noopener"
                               class="flex-1 text-sm text-primary hover:underline truncate">
                                Voir le PDF actuel
                            </a>
                            <label class="inline-flex items-center gap-1.5 text-xs text-red-600 cursor-pointer">
                                <input type="checkbox" name="removeGuideTaillePdf" value="1"
                                       class="w-3.5 h-3.5 rounded border-gray-300 text-red-500">
                                Supprimer
                            </label>
                        </div>
                    {% endif %}

                    <input type="file"
                           name="guideTaillePdfFile"
                           accept="application/pdf,.pdf"
                           class="block w-full text-sm text-gray-700 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-primary file:text-white file:cursor-pointer hover:file:bg-secondary">
                    <p class="text-xs text-gray-500 mt-1">
                        {% if template and template.guideTaillePdfUrl %}
                            Sélectionne un nouveau PDF pour remplacer l'actuel.
                        {% else %}
                            S'affichera sur la page des articles utilisant ce template.
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        {# Caractéristiques liées #}
        <div class="card p-6">
            <h2 class="text-xl font-bold mb-1">Caractéristiques incluses</h2>
            <p class="text-sm text-gray-500 mb-4">
                Cochez les caractéristiques à inclure dans ce template. Les variantes seront générées à partir de toutes les combinaisons possibles.
            </p>

            {% if caracteristiques|length > 0 %}
                <div class="space-y-3">
                    {% for carac in caracteristiques %}
                        {% set isChecked = template and carac in template.caracteristiques %}
                        <label class="flex items-start gap-3 p-3 rounded-lg border hover:border-primary/30 hover:bg-accent/20 cursor-pointer transition-colors {{ isChecked ? 'border-primary/30 bg-accent/20' : 'border-gray-200' }}">
                            <input type="checkbox"
                                   name="caracteristiques[]"
                                   value="{{ carac.id }}"
                                   {{ isChecked ? 'checked' : '' }}
                                   class="w-4 h-4 text-primary rounded mt-0.5">
                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-dark">{{ carac.nom }}</span>
                                    {% if carac.type == 'color' %}
                                        <span class="px-1.5 py-0.5 bg-purple-100 text-purple-700 rounded text-xs">Couleur</span>
                                    {% elseif carac.type == 'select' %}
                                        <span class="px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded text-xs">Sélection</span>
                                    {% else %}
                                        <span class="px-1.5 py-0.5 bg-gray-100 text-gray-600 rounded text-xs">Texte</span>
                                    {% endif %}
                                </div>
                                {% set valeurs = carac.valeursArray %}
                                {% if valeurs|length > 0 %}
                                    <div class="flex flex-wrap gap-1 mt-1">
                                        {% for v in valeurs|slice(0, 5) %}
                                            <span class="text-xs text-gray-500 bg-gray-100 px-1.5 py-0.5 rounded">{{ v }}</span>
                                        {% endfor %}
                                        {% if valeurs|length > 5 %}
                                            <span class="text-xs text-gray-400">+{{ valeurs|length - 5 }} autres</span>
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </div>
                        </label>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-8 bg-gray-50 rounded-lg">
                    <p class="text-gray-500 text-sm mb-3">Aucune caractéristique disponible.</p>
                    <a href="{{ path('admin_caracteristiques_new') }}" class="text-primary hover:text-secondary text-sm font-medium">
                        Créer des caractéristiques d'abord →
                    </a>
                </div>
            {% endif %}
        </div>

        {# Personnalisations proposables #}
        <div class="card p-6">
            <h2 class="text-xl font-bold mb-1">Personnalisations proposables</h2>
            <p class="text-sm text-gray-500 mb-4">
                Cochez les demandes de personnalisation proposées sur la fiche des articles utilisant ce template.
                Si aucune n'est cochée, le bouton « Personnaliser » n'apparaît pas.
            </p>

            {% if personnalisations|length > 0 %}
                <div class="space-y-3">
                    {% for perso in personnalisations %}
                        {% set isChecked = template and perso in template.personnalisations %}
                        <label class="flex items-center gap-3 p-3 rounded-lg border hover:border-primary/30 hover:bg-accent/20 cursor-pointer transition-colors {{ isChecked ? 'border-primary/30 bg-accent/20' : 'border-gray-200' }}">
                            <input type="checkbox"
                                   name="personnalisations[]"
                                   value="{{ perso.id }}"
                                   {{ isChecked ? 'checked' : '' }}
                                   class="w-4 h-4 text-primary rounded">
                            <span class="font-semibold text-dark">{{ perso.nom }}</span>
                            {% if not perso.actif %}
                                <span class="px-1.5 py-0.5 bg-gray-100 text-gray-500 rounded text-xs">Inactif</span>
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-8 bg-gray-50 rounded-lg">
                    <p class="text-gray-500 text-sm mb-3">Aucune personnalisation disponible.</p>
                    <a href="{{ path('admin_personnalisations_new') }}" class="text-primary hover:text-secondary text-sm font-medium">
                        Créer des personnalisations d'abord →
                    </a>
                </div>
            {% endif %}
        </div>

        {# Actions #}
        <div class="flex gap-3">
            <button type="submit" class="btn-primary">
                {{ template ? 'Mettre à jour' : 'Créer' }} le template
            </button>
            <a href="{{ path('admin_templates') }}" class="btn-outline">
                Annuler
            </a>
        </div>
    </div>
</form>
{% endblock %}
