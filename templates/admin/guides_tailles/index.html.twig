{% extends 'admin/base_admin.html.twig' %}

{% block title %}Guides des tailles{% endblock %}
{% block page_title %}Guides des tailles{% endblock %}
{% block page_subtitle %}
    <p class="text-sm text-gray-600">Tableaux de mensurations associables aux articles</p>
{% endblock %}

{% block body %}
    <div class="flex justify-end mb-6">
        <a href="{{ path('admin_guides_tailles_new') }}" class="btn-primary">+ Nouveau guide</a>
    </div>

    <div class="card overflow-hidden">
        {% if guides|length > 0 %}
            <table class="w-full">
                <thead class="bg-gray-50 border-b">
                    <tr>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Nom</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Slug</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Tailles</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Unité</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Statut</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y">
                    {% for guide in guides %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 font-semibold">{{ guide.nom }}</td>
                            <td class="px-6 py-4 text-sm text-gray-500 font-mono">{{ guide.slug }}</td>
                            <td class="px-6 py-4 text-sm text-gray-600">{{ guide.lignes|length }} taille{{ guide.lignes|length > 1 ? 's' : '' }}</td>
                            <td class="px-6 py-4 text-sm text-gray-600">{{ guide.unite }}</td>
                            <td class="px-6 py-4">
                                {% if guide.actif %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-green-100 text-green-700">Actif</span>
                                {% else %}
                                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-gray-100 text-gray-500">Inactif</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex gap-3">
                                    <a href="{{ path('guide_taille_view', {slug: guide.slug}) }}" target="_blank" class="text-gray-700 hover:text-gray-900">Voir</a>
                                    <a href="{{ path('admin_guides_tailles_edit', {id: guide.id}) }}" class="text-primary hover:text-secondary">Modifier</a>
                                    <form method="post" action="{{ path('admin_guides_tailles_clone', {id: guide.id}) }}">
                                        <button type="submit" class="text-blue-600 hover:text-blue-700">Cloner</button>
                                    </form>
                                    <form method="post" action="{{ path('admin_guides_tailles_delete', {id: guide.id}) }}"
                                          onsubmit="window.confirmForm(event, this, 'Supprimer ce guide ?')">
                                        <button type="submit" class="text-red-600 hover:text-red-700">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div class="text-center py-16">
                <p class="text-gray-500 mb-4">Aucun guide de tailles</p>
                <a href="{{ path('admin_guides_tailles_new') }}" class="btn-primary">Créer le premier guide</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
