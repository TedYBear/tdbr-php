{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ collection ? 'Modifier' : 'Nouvelle' }} Collection{% endblock %}
{% block page_title %}{{ collection ? 'Modifier' : 'Nouvelle' }} Collection{% endblock %}

{% block body %}
    <div class="max-w-2xl">
        <form method="post" class="card p-6 space-y-6">
            <div class="form-group">
                <label>Nom *</label>
                <input type="text" name="nom" value="{{ collection ? collection.nom : '' }}" required class="form-input">
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" rows="3" class="form-textarea">{{ collection ? collection.description : '' }}</textarea>
            </div>

            <div class="form-group">
                <label>Catégorie *</label>
                <select name="categorie" required class="form-input">
                    <option value="">-- Sélectionner une catégorie --</option>
                    {% for cat in categories %}
                        <option value="{{ cat.id }}" {{ collection and collection.categorie and collection.categorie.id == cat.id ? 'selected' : '' }}>
                            {{ cat.nom }}{{ cat.lienDirectUniquement ? ' (Lien direct)' : '' }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            {% include 'components/admin/_image_uploader.html.twig' with {
                fieldName: 'image',
                currentImage: collection ? collection.image : '',
                directory: 'collections',
                label: 'Image de la collection'
            } %}

            <div class="flex items-center gap-3">
                <input type="checkbox" name="actif" id="actif" {{ collection and collection.actif ? 'checked' : (not collection ? 'checked' : '') }} class="w-5 h-5 text-primary rounded">
                <label for="actif" class="cursor-pointer">Collection active</label>
            </div>

            <div class="pt-2 border-t border-gray-100">
                <div class="flex items-center gap-3">
                    <input type="checkbox" name="lienDirectUniquement" id="lienDirectUniquement"
                           {{ collection and collection.lienDirectUniquement ? 'checked' : '' }}
                           class="w-5 h-5 text-primary rounded">
                    <label for="lienDirectUniquement" class="cursor-pointer font-medium">Visible uniquement par lien direct</label>
                </div>
                <p class="text-xs text-gray-500 mt-1 pl-8">
                    Masquée du catalogue public. La collection doit être <strong>active</strong> pour que le lien direct soit accessible (donne aussi accès à tous ses articles).
                </p>
                {% if collection and not collection.lienDirectUniquement and collection.effectivelyPrivate %}
                    <p class="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-2 mt-2">
                        Cette collection hérite actuellement du mode « Lien direct » depuis sa catégorie parente.
                    </p>
                {% endif %}
            </div>

            <div class="flex gap-3 pt-4">
                <button type="submit" class="btn-primary">{{ collection ? 'Mettre à jour' : 'Créer' }}</button>
                <a href="{{ path('admin_collections') }}" class="btn-outline">Annuler</a>
            </div>
        </form>

        {% if collection and collection.lienDirectUniquement and collection.accessToken %}
            {% include 'components/admin/_direct_link_box.html.twig' with {
                shareUrl: url('collection', {slug: collection.slug, cle: collection.accessToken}),
                regenerateUrl: path('admin_collections_regenerate_token', {id: collection.id}),
                label: 'cette collection et ses articles',
                isActif: collection.actif
            } %}
        {% endif %}
    </div>
{% endblock %}
