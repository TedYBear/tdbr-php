<aside x-cloak
       class="fixed left-0 z-50 w-64 bg-gradient-to-b from-primary to-primary/90 text-white flex-shrink-0"
       style="top:0;bottom:0;overflow-y:auto;transition:transform 0.3s ease-in-out;"
       :style="{ transform: sidebarOpen ? 'translateX(0)' : 'translateX(-100%)' }">
    <div class="p-6">
        {# Logo + bouton fermer (mobile) #}
        <div class="flex items-center justify-between mb-8">
            <a href="{{ path('home') }}" class="flex items-center gap-3">
                <div class="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
                    <span class="text-primary font-black text-xl">T</span>
                </div>
                <div>
                    <div class="font-heading text-xl font-black">TDBR</div>
                    <div class="text-xs text-white/70">Administration</div>
                </div>
            </a>
            <button @click="sidebarOpen = false"
                    class="p-1 text-white/70 hover:text-white rounded md:hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        {# Menu — état des groupes persisté en localStorage #}
        <nav class="space-y-1"
             x-data="{
                groups: JSON.parse(localStorage.getItem('tdbrAdminNav') || '{}'),
                isOpen(k, active) { return this.groups.hasOwnProperty(k) ? this.groups[k] : active; },
                toggle(k, active) { this.groups[k] = !this.isOpen(k, active); localStorage.setItem('tdbrAdminNav', JSON.stringify(this.groups)); }
             }">

            {# Dashboard (entrée seule) #}
            <a href="{{ path('admin_dashboard') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'bg-white/20' : '' }}">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                </svg>
                <span class="font-medium">Dashboard</span>
            </a>

            {# Groupes repliables #}
            {% for group in nav_groups %}
                {% set group_active = false %}
                {% for item in group.items %}
                    {% if app.request.attributes.get('_route') starts with item.prefix %}
                        {% set group_active = true %}
                    {% endif %}
                {% endfor %}

                <div class="pt-1">
                    {# En-tête de groupe #}
                    <button type="button"
                            @click="toggle('{{ group.key }}', {{ group_active ? 'true' : 'false' }})"
                            class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg hover:bg-white/10 transition text-left">
                        <svg class="w-5 h-5 flex-shrink-0 text-white/80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ group.icon }}"></path>
                        </svg>
                        <span class="font-semibold text-xs uppercase tracking-wider text-white/90 flex-1">{{ group.label }}</span>
                        <svg class="w-4 h-4 flex-shrink-0 text-white/60 transition-transform duration-200"
                             :class="isOpen('{{ group.key }}', {{ group_active ? 'true' : 'false' }}) ? 'rotate-180' : ''"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </button>

                    {# Sous-entrées #}
                    <div x-show="isOpen('{{ group.key }}', {{ group_active ? 'true' : 'false' }})"
                         x-cloak
                         x-collapse
                         class="mt-1 ml-4 pl-3 border-l border-white/15 space-y-0.5">
                        {% for item in group.items %}
                            {% set item_active = app.request.attributes.get('_route') starts with item.prefix %}
                            <a href="{{ path(item.route) }}"
                               class="flex items-center gap-3 px-3 py-2 rounded-lg transition text-sm {{ item_active ? 'bg-white/20 font-medium text-white' : 'text-white/85 hover:bg-white/10 hover:text-white' }}">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ item.icon }}"></path>
                                </svg>
                                <span>{{ item.label }}</span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}

            <div class="my-4 border-t border-white/20"></div>

            {# Configuration (entrée seule) #}
            <a href="{{ path('admin_site_config') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition {{ app.request.attributes.get('_route') starts with 'admin_site_config' ? 'bg-white/20' : '' }}">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
                <span class="font-medium">Configuration</span>
            </a>

            {# Retour site #}
            <a href="{{ path('home') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-white/10 transition text-white/80 hover:text-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                <span class="font-medium">Retour au site</span>
            </a>
        </nav>
    </div>
</aside>
