{% extends 'base.html.twig' %}

{% block title %}{{ article.nom }} - TDBR{% endblock %}

{# prixBase calculé ici pour être disponible dans tous les blocs #}
{% set prixBase = 0 %}
{% if article.grillePrix %}{% for p in article.grillePrix.paliers %}{% if p.min == 1 and p.prixVente is not null and prixBase == 0 %}{% set prixBase = p.prixVente %}{% endif %}{% endfor %}{% endif %}

{# Personnalisations proposables = celles (actives) du template de l'article #}
{% set persoList = [] %}
{% if article.varianteTemplate %}{% for p in article.varianteTemplate.personnalisations %}{% if p.actif %}{% set persoList = persoList|merge([p]) %}{% endif %}{% endfor %}{% endif %}

{% block javascripts %}
    {#
     IMPORTANT: ce <script nonce="{{ csp_nonce() }}"> doit être AVANT {{ parent() }} pour que le listener
     alpine:init soit enregistré avant que le bundle app.js appelle Alpine.start().
    #}
    <script nonce="{{ csp_nonce() }}">
        document.addEventListener('alpine:init', () => {
            Alpine.data('articlePage', () => ({
                selectedImage: 0,
                quantity: 1,
                lightboxOpen: false,
                addingToCart: false,
                selectedVarianteId: null,

                {% set variantesJson = [] %}
                {% for v in article.variantes %}
                    {% if v.actif %}
                        {% set variantesJson = variantesJson|merge([{id: v.id, nom: v.nom, deltaPrix: v.deltaPrix, valeurs: v.valeurs}]) %}
                    {% endif %}
                {% endfor %}
                variants: {{ variantesJson|json_encode|raw }},

                {% set imagesArr = [] %}
                {% for img in article.images %}
                    {% set imagesArr = imagesArr|merge([{url: img.url, alt: img.alt}]) %}
                {% endfor %}
                imagesData: {{ imagesArr|json_encode|raw }},

                basePrice: {{ prixBase }},
                choices: {},

                get images() {
                    return this.imagesData.map(img => img.url);
                },

                /**
                 * True si au moins une variante active a des valeurs structurées.
                 */
                get hasStructuredVariants() {
                    return this.variants.some(v => v.valeurs && Object.keys(v.valeurs).length > 0);
                },

                /**
                 * Extrait les caractéristiques et leurs valeurs depuis les variantes structurées.
                 */
                get caracteristiques() {
                    const caracs = {};
                    const order = [];
                    this.variants.forEach(v => {
                        if (!v.valeurs) return;
                        Object.entries(v.valeurs).forEach(([nom, val]) => {
                            if (!caracs[nom]) { caracs[nom] = []; order.push(nom); }
                            if (!caracs[nom].includes(val)) caracs[nom].push(val);
                        });
                    });
                    // Ignore les caractéristiques dont la seule valeur est le titre de l'article
                    // (cas où l'import Printful a mal parsé un nom de variante "Titre / Taille")
                    const articleNom = {{ article.nom|json_encode|raw }};
                    return order
                        .map(nom => ({ nom, valeurs: caracs[nom] }))
                        .filter(c => !(c.valeurs.length === 1 && c.valeurs[0] === articleNom));
                },

                /**
                 * Variante sélectionnée.
                 * - Mode structuré : match par valeurs
                 * - Mode simple   : match par ID sélectionné dans le dropdown
                 */
                get selectedVariant() {
                    if (this.hasStructuredVariants) {
                        if (this.caracteristiques.length === 0) return null;
                        if (!this.allSelected) return null;
                        return this.variants.find(v => {
                            if (!v.valeurs) return false;
                            return Object.entries(this.choices).every(([k, val]) => v.valeurs[k] === val);
                        }) || null;
                    } else {
                        if (!this.selectedVarianteId) return null;
                        return this.variants.find(v => v.id == this.selectedVarianteId) || null;
                    }
                },

                get currentPrice() {
                    const delta = this.selectedVariant
                        ? (parseFloat(this.selectedVariant.deltaPrix) || 0)
                        : 0;
                    return this.basePrice + delta;
                },

                get allSelected() {
                    if (!this.hasStructuredVariants) {
                        return this.variants.length === 0 || this.selectedVarianteId !== null;
                    }
                    const caracs = this.caracteristiques;
                    if (caracs.length === 0) return true;
                    return caracs.every(c => this.choices[c.nom] && this.choices[c.nom] !== '');
                },

                get variantUnavailable() {
                    if (!this.hasStructuredVariants) return false;
                    return this.caracteristiques.length > 0 && this.allSelected && !this.selectedVariant;
                },

                async addToCart() {
                    this.addingToCart = true;

                    const choicesPayload = this.hasStructuredVariants
                        ? this.choices
                        : (this.selectedVariant ? { 'Variante': this.selectedVariant.nom } : {});

                    const data = {
                        articleId: {{ article.id }},
                        quantity: this.quantity,
                        choices: choicesPayload
                    };

                    if (this.selectedVariant) {
                        data.variantId = this.selectedVariant.id;
                    }

                    try {
                        const response = await fetch('{{ path('panier_add') }}', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();

                        if (result.success) {
                            const badge = document.querySelector('[data-cart-count]');
                            if (badge) {
                                badge.textContent = result.cartCount;
                                badge.classList.remove('hidden');
                            }
                            const btn = this.$refs.addBtn;
                            if (btn) {
                                btn.classList.add('animate-pulse');
                                setTimeout(() => btn.classList.remove('animate-pulse'), 1000);
                            }
                            window.showToast('Article ajouté au panier !');
                        }
                    } catch (error) {
                        window.showToast('Erreur lors de l\'ajout au panier', 'error');
                    } finally {
                        this.addingToCart = false;
                    }
                },

                // --- Modale de demande de personnalisation sur-mesure ---
                persoOpen: false,
                persoSubmitting: false,
                persoSubmitted: false,
                persoError: '',
                perso: { typeDemande: '', commentaire: '', website: '' },

                openPerso() {
                    this.persoSubmitted = false;
                    this.persoError = '';
                    this.persoOpen = true;
                },

                async submitPerso() {
                    this.persoError = '';
                    if (!this.perso.typeDemande) { this.persoError = 'Veuillez choisir un type de demande.'; return; }

                    this.persoSubmitting = true;
                    try {
                        const response = await fetch('{{ path('demande_personnalisation') }}', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
                            },
                            body: JSON.stringify({
                                articleId: {{ article.id }},
                                typeDemande: this.perso.typeDemande,
                                commentaire: this.perso.commentaire,
                                website: this.perso.website
                            })
                        });
                        const result = await response.json();
                        if (response.ok && result.success) {
                            this.persoSubmitted = true;
                        } else {
                            this.persoError = result.error || 'Une erreur est survenue. Merci de réessayer.';
                        }
                    } catch (e) {
                        this.persoError = 'Erreur réseau. Merci de réessayer.';
                    } finally {
                        this.persoSubmitting = false;
                    }
                }
            }));
        });
    </script>
    {{ parent() }}
{% endblock %}

{% block body %}
<div x-data="articlePage">
    {# Breadcrumb #}
    <section class="bg-gray-50 py-4">
        <div class="container mx-auto px-4">
            <nav class="flex items-center space-x-2 text-sm">
                <a href="{{ path('home') }}" class="text-gray-600 hover:text-primary">Accueil</a>
                <span class="text-gray-400">/</span>
                <a href="{{ path('catalogue') }}" class="text-gray-600 hover:text-primary">Catalogue</a>
                {% if category %}
                    <span class="text-gray-400">/</span>
                    <a href="{{ path('categorie', {slug: category.slug}) }}" class="text-gray-600 hover:text-primary">{{ category.nom }}</a>
                {% endif %}
                <span class="text-gray-400">/</span>
                <span class="text-primary font-medium">{{ article.nom }}</span>
            </nav>
        </div>
    </section>

    {# Contenu Principal #}
    <section class="py-16 bg-white">
        <div class="container mx-auto px-4">
            <div class="grid lg:grid-cols-2 gap-16">
                {# Galerie Images #}
                <div class="space-y-6">
                    {# Image principale #}
                    <div class="relative aspect-square bg-gradient-to-br from-accent/20 to-white rounded-2xl overflow-hidden shadow-xl group">
                        {% if article.images|length > 0 %}
                            <img :src="images && images[selectedImage] ? images[selectedImage] : '{{ article.images[0].url }}'"
                                 alt="{{ article.images[0].alt ?? article.nom }}"
                                 class="w-full h-full object-contain cursor-zoom-in transition-transform duration-500 group-hover:scale-105"
                                 @click="lightboxOpen = true"
                                 onerror="this.src='{{ article.images[0].url }}'">

                            {% set daysSinceCreation = 'now'|date('U') - article.createdAt|date('U') %}
                            {% if daysSinceCreation < (7 * 24 * 3600) %}
                                <div class="absolute top-4 left-4 px-4 py-2 bg-gradient-to-r from-secondary to-primary text-white font-bold rounded-full shadow-lg glow">
                                    Nouveau
                                </div>
                            {% endif %}
                        {% else %}
                            <div class="w-full h-full flex items-center justify-center text-gray-400">
                                <svg class="w-24 h-24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                            </div>
                        {% endif %}
                    </div>

                    {# Miniatures #}
                    {% if article.images|length > 1 %}
                        <div class="grid grid-cols-4 gap-2 md:gap-4">
                            {% for image in article.images|slice(0, 4) %}
                                <div class="aspect-square bg-gray-100 rounded-xl overflow-hidden cursor-pointer transition-all duration-300 hover:ring-4 hover:ring-primary hover:scale-105"
                                     :class="selectedImage === {{ loop.index0 }} ? 'ring-4 ring-primary' : ''"
                                     @click="selectedImage = {{ loop.index0 }}">
                                    <img src="{{ image.url }}" alt="{{ image.alt ?? article.nom }}" class="w-full h-full object-contain">
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>

                {# Détails Produit #}
                <div class="space-y-8">
                    {# Titre et collection #}
                    <div>
                        {% if collection %}
                            <a href="{{ path('collection', {slug: collection.slug}) }}"
                               class="inline-flex items-center gap-2 text-sm text-secondary font-semibold hover:text-primary mb-3">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                                </svg>
                                Collection {{ collection.nom }}
                            </a>
                        {% endif %}

                        <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-black text-gray-900 mb-4">
                            {{ article.nom }}
                        </h1>

                        {% if article.description %}
                            <p class="text-xl text-gray-600 leading-relaxed">
                                {{ article.description }}
                            </p>
                        {% endif %}

                        {# Fournisseur #}
                        {% if article.fournisseur %}
                            <div class="mt-4 flex items-center gap-3">
                                {% if article.fournisseur.logoFilename %}
                                    <img src="/uploads/fournisseurs/{{ article.fournisseur.logoFilename }}"
                                         alt="{{ article.fournisseur.nom }}"
                                         class="h-8 w-auto object-contain opacity-80">
                                {% endif %}
                                {% if article.fournisseur.url %}
                                    <a href="{{ article.fournisseur.url }}" target="_blank" rel="noopener"
                                       class="text-sm text-gray-500 hover:text-primary">{{ article.fournisseur.nom }}</a>
                                {% else %}
                                    <span class="text-sm text-gray-500">{{ article.fournisseur.nom }}</span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {# Prix — mis à jour dynamiquement selon la variante sélectionnée #}
                    {% if article.grillePrix %}
                    <div class="flex items-baseline gap-4">
                        <span class="text-4xl md:text-5xl font-black text-primary"
                              x-text="currentPrice.toFixed(2).replace('.', ',') + ' €'">
                            {{ prixBase|number_format(2, ',', ' ') }} €
                        </span>
                    </div>
                    {% else %}
                    <div class="px-4 py-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-800 text-sm font-medium">
                        Prix non disponible — cet article n'est pas commandable pour le moment.
                    </div>
                    {% endif %}

                    {# Tableau de prix dégressifs #}
                    {% if article.grillePrix %}
                        {% set paliers = article.grillePrix.paliers %}
                        {% set hasData = false %}
                        {% for p in paliers %}{% if p.prixVente is not null %}{% set hasData = true %}{% endif %}{% endfor %}

                        {% if hasData %}
                            <div class="bg-gray-50 rounded-xl border border-gray-200 overflow-hidden">
                                <div class="px-4 py-3 bg-gray-100 border-b border-gray-200">
                                    <h3 class="font-semibold text-gray-700 text-sm">Tarifs dégressifs</h3>
                                </div>
                                <table class="w-full text-sm">
                                    <thead>
                                        <tr class="text-xs text-gray-500 uppercase border-b border-gray-200">
                                            <th class="px-4 py-2 text-left font-semibold">Quantité</th>
                                            <th class="px-4 py-2 text-right font-semibold">Prix unitaire</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-100">
                                        {% for palier in paliers %}
                                            {% if palier.prixVente is not null %}
                                                <tr class="hover:bg-white transition-colors">
                                                    <td class="px-4 py-2 text-gray-700">{{ palier.label }}</td>
                                                    <td class="px-4 py-2 text-right font-bold text-primary">
                                                        {{ palier.prixVente|number_format(2, ',', ' ') }} €
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    {% endif %}

                    {# Lien politique tarifaire #}
                    <a href="{{ path('presentation_tarifs') }}"
                       class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-primary transition">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Politique tarifaire &amp; frais de port
                    </a>

                    {# Lien PDF guide des tailles (si template + URL définis) #}
                    {% if article.varianteTemplate and article.varianteTemplate.guideTaillePdfUrl %}
                        <a href="{{ article.varianteTemplate.guideTaillePdfUrl }}"
                           target="_blank" rel="noopener"
                           class="inline-flex items-center gap-2 px-4 py-2.5 border-2 border-primary/20 hover:border-primary hover:bg-primary hover:text-white text-primary rounded-xl font-semibold text-sm transition-all">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                            </svg>
                            <span>Consulter le guide des tailles</span>
                            <svg class="w-4 h-4 ml-auto opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                        </a>
                    {% endif %}

                    {# Sélection variante simple (variantes sans valeurs structurées) #}
                    <div x-show="!hasStructuredVariants && variants.length > 0" class="space-y-3">
                        <template x-if="variants.length > 1">
                            <div>
                                <label style="display:block;font-size:1.125rem;font-weight:700;color:#111827;margin-bottom:0.5rem;">
                                    Variante
                                </label>
                                <select x-model="selectedVarianteId"
                                        style="display:block;width:100%;padding:0.75rem 1rem;border:2px solid #e5e7eb;border-radius:0.75rem;font-size:1rem;background:#fff;cursor:pointer;"
                                        @change="$el.style.borderColor = selectedVarianteId ? '#4F8A3D' : '#e5e7eb'">
                                    <option value="">-- Choisir une variante --</option>
                                    <template x-for="v in variants" :key="v.id">
                                        <option :value="v.id" x-text="v.nom"></option>
                                    </template>
                                </select>
                            </div>
                        </template>
                        <template x-if="variants.length === 1">
                            <div x-init="selectedVarianteId = variants[0].id">
                                <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;background:#f3f4f6;border-radius:0.5rem;font-weight:600;color:#374151;">
                                    <svg style="width:1rem;height:1rem;color:#4F8A3D;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    <span x-text="variants[0].nom"></span>
                                </span>
                            </div>
                        </template>
                    </div>

                    {# Sélection par caractéristiques (variantes avec valeurs structurées) #}
                    <div x-show="hasStructuredVariants && caracteristiques.length > 0" class="space-y-5">
                        <template x-for="carac in caracteristiques" :key="carac.nom">
                            <div>
                                <label style="display:block;font-size:1.125rem;font-weight:700;color:#111827;margin-bottom:0.5rem;"
                                       x-text="carac.nom"></label>

                                {# Dropdown si plusieurs valeurs #}
                                <template x-if="carac.valeurs.length > 1">
                                    <select x-model="choices[carac.nom]"
                                            style="display:block;width:100%;padding:0.75rem 1rem;border:2px solid #e5e7eb;border-radius:0.75rem;font-size:1rem;background:#fff;cursor:pointer;"
                                            @change="$el.style.borderColor = choices[carac.nom] ? '#4F8A3D' : '#e5e7eb'">
                                        <option value="" x-text="'-- Choisir ' + carac.nom.toLowerCase() + ' --'"></option>
                                        <template x-for="val in carac.valeurs" :key="val">
                                            <option :value="val" x-text="val"></option>
                                        </template>
                                    </select>
                                </template>

                                {# Affichage statique si une seule valeur #}
                                <template x-if="carac.valeurs.length === 1">
                                    <div x-init="choices[carac.nom] = carac.valeurs[0]">
                                        <span style="display:inline-flex;align-items:center;gap:0.5rem;padding:0.5rem 1rem;background:#f3f4f6;border-radius:0.5rem;font-weight:600;color:#374151;">
                                            <svg style="width:1rem;height:1rem;color:#4F8A3D;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                            </svg>
                                            <span x-text="carac.valeurs[0]"></span>
                                        </span>
                                    </div>
                                </template>
                            </div>
                        </template>

                        {# Sélection incomplète #}
                        <p x-show="!allSelected"
                           style="font-size:0.875rem;color:#dc2626;font-weight:500;">
                            Veuillez sélectionner toutes les options
                        </p>

                        {# Combinaison non disponible #}
                        <p x-show="variantUnavailable"
                           style="font-size:0.875rem;color:#d97706;font-weight:500;background:#fef3c7;padding:0.5rem 0.75rem;border-radius:0.5rem;">
                            Cette combinaison n'est pas disponible
                        </p>
                    </div>

                    {# Quantité et Ajout Panier #}
                    <div class="space-y-4">
                        <label class="block text-lg font-bold text-gray-900">Quantité</label>
                        <div class="flex items-center gap-3 md:gap-6">
                            <div class="flex items-center border-2 border-gray-200 rounded-xl overflow-hidden">
                                <button type="button"
                                        @click="quantity = Math.max(1, quantity - 1)"
                                        class="px-6 py-4 bg-gray-100 hover:bg-gray-200 transition">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
                                    </svg>
                                </button>
                                <input type="number"
                                       x-model.number="quantity"
                                       min="1"
                                       class="w-20 px-4 py-4 text-center text-xl font-bold border-0 focus:outline-none">
                                <button type="button"
                                        @click="quantity = quantity + 1"
                                        class="px-6 py-4 bg-gray-100 hover:bg-gray-200 transition">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                </button>
                            </div>

                            <button type="button"
                                    x-ref="addBtn"
                                    @click="addToCart()"
                                    :disabled="addingToCart || !allSelected || variantUnavailable"
                                    {% if not article.grillePrix %}disabled{% endif %}
                                    class="btn-primary flex-1 py-4 text-xl disabled:opacity-50 disabled:cursor-not-allowed">
                                <span x-show="!addingToCart" class="flex items-center justify-center gap-3">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                                    </svg>
                                    Ajouter au Panier
                                </span>
                                <span x-show="addingToCart" class="flex items-center justify-center gap-3">
                                    <svg class="w-6 h-6 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                                    </svg>
                                    Ajout en cours...
                                </span>
                            </button>
                        </div>
                    </div>

                    {# Demande de personnalisation sur-mesure (uniquement si le template propose des personnalisations) #}
                    {% if persoList|length > 0 %}
                    <div class="pt-2">
                        {% if app.user %}
                            <button type="button"
                                    @click="openPerso()"
                                    class="w-full py-4 text-lg border-2 border-primary text-primary rounded-xl font-bold hover:bg-primary hover:text-white transition flex items-center justify-center gap-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"></path>
                                </svg>
                                Personnaliser ce produit
                            </button>
                            <p class="text-center text-sm text-gray-500 mt-2">
                                Une envie particulière (couleur, taille, modèle) ? Envoyez votre demande, réponse au plus vite.
                            </p>
                        {% else %}
                            <button type="button" disabled
                                    class="w-full py-4 text-lg border-2 border-gray-200 text-gray-400 rounded-xl font-bold cursor-not-allowed flex items-center justify-center gap-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"></path>
                                </svg>
                                Personnaliser ce produit
                            </button>
                            <p class="text-center text-sm text-gray-500 mt-2">
                                <a href="{{ path('connexion', {redirect: app.request.pathinfo}) }}" class="text-primary font-semibold hover:underline">Connectez-vous</a> pour demander une personnalisation.
                            </p>
                        {% endif %}
                    </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </section>

    {# Articles Similaires #}
    {% if similarArticles|length > 0 %}
        <section class="py-24 bg-gradient-to-b from-accent/10 to-white">
            <div class="container mx-auto px-4">
                <h2 class="font-heading text-4xl font-bold text-center mb-12">
                    Vous pourriez aussi <span class="gradient-text">aimer</span>
                </h2>
                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
                    {% for similar in similarArticles %}
                        <div class="section-appear" style="animation-delay: {{ loop.index * 0.1 }}s;">
                            {% include 'components/article_card.html.twig' with {'article': similar} %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    {# Lightbox #}
    <div x-show="lightboxOpen"
         x-cloak
         @keydown.escape.window="lightboxOpen = false"
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 p-4"
         @click.self="lightboxOpen = false">
        <button @click="lightboxOpen = false"
                class="absolute top-4 right-4 p-3 text-white hover:bg-white/10 rounded-full transition">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
        {% if article.images|length > 0 %}
            <img :src="images && images[selectedImage] ? images[selectedImage] : '{{ article.images[0].url }}'"
                 alt="{{ article.images[0].alt ?? article.nom }}"
                 class="max-w-full max-h-full object-contain rounded-xl"
                 onerror="this.src='{{ article.images[0].url }}'">
        {% endif %}
    </div>

    {# Modale : demande de personnalisation sur-mesure #}
    {% if persoList|length > 0 %}
    <div x-show="persoOpen"
         x-cloak
         @keydown.escape.window="persoOpen = false"
         class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 overflow-y-auto"
         @click.self="persoOpen = false">
        <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto">

            {# En-tête #}
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 sticky top-0 bg-white rounded-t-2xl">
                <h3 class="font-heading text-xl font-bold text-gray-900">Personnaliser ce produit</h3>
                <button type="button" @click="persoOpen = false" class="p-2 text-gray-400 hover:text-gray-700 rounded-full hover:bg-gray-100 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            {# Vue formulaire #}
            <div x-show="!persoSubmitted" class="p-6 space-y-5">
                <p class="text-sm text-gray-600">
                    Décrivez la personnalisation souhaitée pour <span class="font-semibold text-gray-800">{{ article.nom }}</span>.
                    Nous revenons vers vous par email dans les plus brefs délais.
                </p>

                {# Honeypot anti-spam (caché) #}
                <input type="text" x-model="perso.website" tabindex="-1" autocomplete="off" aria-hidden="true"
                       style="position:absolute;left:-9999px;width:0;height:0;overflow:hidden;">

                {# Type de demande (issu du template de l'article) #}
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Type de demande</label>
                    <select x-model="perso.typeDemande" class="form-input">
                        <option value="">-- Choisir --</option>
                        {% for p in persoList %}
                            <option value="{{ p.nom }}">{{ p.nom }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Commentaire #}
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Commentaire</label>
                    <textarea x-model="perso.commentaire" rows="4" class="form-input" placeholder="Précisez votre demande de personnalisation…"></textarea>
                </div>

                {# Contact #}
                <div class="flex items-center gap-2 text-sm text-gray-600 bg-gray-50 rounded-lg px-3 py-2">
                    <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                    Vous serez recontacté(e) par email.
                </div>

                {# Erreur #}
                <p x-show="persoError" x-text="persoError" x-cloak
                   class="text-sm text-red-600 font-medium bg-red-50 rounded-lg px-3 py-2"></p>

                {# Actions #}
                <div class="flex gap-3 pt-2">
                    <button type="button" @click="persoOpen = false"
                            class="px-5 py-3 rounded-xl border-2 border-gray-200 text-gray-600 font-semibold hover:bg-gray-50 transition">
                        Annuler
                    </button>
                    <button type="button" @click="submitPerso()" :disabled="persoSubmitting"
                            class="btn-primary flex-1 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
                        <span x-show="!persoSubmitting">Envoyer ma demande</span>
                        <span x-show="persoSubmitting" x-cloak>Envoi en cours…</span>
                    </button>
                </div>
            </div>

            {# Vue confirmation #}
            <div x-show="persoSubmitted" x-cloak class="p-8 text-center space-y-4">
                <div class="w-16 h-16 mx-auto rounded-full bg-green-100 flex items-center justify-center">
                    <svg class="w-9 h-9 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h4 class="font-heading text-2xl font-bold text-gray-900">Demande envoyée !</h4>
                <p class="text-gray-600">
                    Merci, votre demande de personnalisation a bien été enregistrée.
                    Nous vous répondrons par email dans les plus brefs délais.
                </p>
                <button type="button" @click="persoOpen = false" class="btn-primary px-8 py-3">Fermer</button>
            </div>

        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
