{% extends 'base.html.twig' %}

{% block title %}Mes partenaires - TDBR{% endblock %}

{% block body %}
    {% include 'public/_presentation_subnav.html.twig' %}

    <div class="min-h-screen bg-gradient-to-b from-gray-50 to-white py-12 md:py-20">
        <div class="container mx-auto px-4 max-w-4xl">

            {# Header #}
            <div class="text-center mb-12 md:mb-16">
                <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-primary mb-4">
                    Mes partenaires
                </h1>
                <p class="text-lg text-gray-600 max-w-2xl mx-auto">
                    Producteurs, dépôts-vente et collaborateurs qui font partie de l'aventure TDBR.
                </p>
            </div>

            <div class="rounded-2xl overflow-hidden shadow-lg mb-12">
                <img src="{{ asset('build/images/pres.png') }}"
                     alt="TedYBear - TDBR"
                     class="w-full object-contain">
            </div>

            <div class="space-y-8">

                {# Producteurs #}
                <div class="card p-8 md:p-10">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-12 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center text-white text-2xl flex-shrink-0">
                            🏭
                        </div>
                        <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary">
                            Producteurs
                        </h2>
                    </div>

                    <div class="space-y-8">

                        {# Printful #}
                        <div class="flex flex-col sm:flex-row gap-6">
                            <div class="flex-shrink-0">
                                <div class="w-20 h-20 bg-gray-50 border border-gray-200 rounded-xl flex items-center justify-center p-2">
                                    <img src="{{ asset('uploads/fournisseurs/logo-printful.svg') }}"
                                         alt="Logo Printful"
                                         class="w-full h-full object-contain">
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex flex-wrap items-center gap-3 mb-2">
                                    <h3 class="font-heading text-xl font-bold text-primary">Printful</h3>
                                    <span class="px-2 py-0.5 bg-accent border border-primary/20 rounded-full text-xs font-medium text-gray-700">T-shirts &amp; vêtements</span>
                                </div>
                                <p class="text-gray-700 leading-relaxed mb-3">
                                    Je fais appel à Printful pour tous mes <strong>t-shirts et vêtements</strong>.
                                    Après une période de tests assez longue, je peux attester de la qualité du support client,
                                    de la qualité d'impression et de la tenue des designs dans le temps.
                                </p>
                                <p class="text-gray-500 text-sm">
                                    Les impressions et envois se font depuis la <strong>Lituanie</strong> (Europe),
                                    même si les vêtements eux-mêmes ne sont pas fabriqués en Europe.
                                </p>
                            </div>
                        </div>

                        <div class="border-t border-gray-100"></div>

                        {# Vistaprint #}
                        <div class="flex flex-col sm:flex-row gap-6">
                            <div class="flex-shrink-0">
                                <div class="w-20 h-20 bg-gray-50 border border-gray-200 rounded-xl flex items-center justify-center p-2">
                                    <img src="{{ asset('uploads/fournisseurs/vista.png') }}"
                                         alt="Logo Vistaprint"
                                         class="w-full h-full object-contain">
                                </div>
                            </div>
                            <div class="flex-1">
                                <div class="flex flex-wrap items-center gap-3 mb-2">
                                    <h3 class="font-heading text-xl font-bold text-primary">Vistaprint</h3>
                                    <span class="px-2 py-0.5 bg-accent border border-primary/20 rounded-full text-xs font-medium text-gray-700">Mugs &amp; accessoires</span>
                                </div>
                                <p class="text-gray-700 leading-relaxed mb-3">
                                    Pour les <strong>mugs, tote-bags et autres accessoires</strong>, je passe par Vistaprint,
                                    qu'on ne présente plus. Production de qualité, livraison rapide et prix raisonnables.
                                </p>
                                <p class="text-gray-500 text-sm">
                                    L'impression est faite en <strong>Europe</strong>, même si, comme Printful,
                                    la plupart des supports ne sont pas fabriqués en Europe.
                                </p>
                            </div>
                        </div>

                    </div>

                    {# Note transparence #}
                    <div class="mt-8 p-4 bg-gray-50 rounded-xl border border-gray-200">
                        <p class="text-sm text-gray-600 leading-relaxed">
                            <strong class="text-gray-800">Note de transparence :</strong>
                            J'étudie pour plus tard la possibilité d'une impression en France —
                            pourquoi pas à Toulouse — mais ce n'est pas pour tout de suite.
                            En attendant, je choisis mes partenaires avant tout pour leur qualité et leur fiabilité.
                        </p>
                    </div>
                </div>

                {# Dépôts-vente #}
                <div class="card p-8 md:p-10">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-12 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center text-white text-2xl flex-shrink-0">
                            🏪
                        </div>
                        <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary">
                            Dépôts-vente
                        </h2>
                    </div>

                    {# Du fromage au dessert #}
                    <div class="flex flex-col sm:flex-row gap-6">
                        <div class="flex-shrink-0">
                            <img src="{{ asset('uploads/general/fromage_dessert.jpg') }}"
                                 alt="Du fromage au dessert - Orthez"
                                 class="w-20 h-20 object-cover rounded-xl border border-gray-200">
                        </div>
                        <div class="flex-1">
                            <h3 class="font-heading text-xl font-bold text-primary mb-1">Du fromage au dessert</h3>
                            <p class="text-sm text-gray-500 mb-3">19 rue des Jacobins, Orthez</p>
                            <p class="text-gray-700 leading-relaxed mb-4">
                                Cette adresse rassemble deux univers complémentaires :
                                la <strong>fromagerie d'Orthez</strong> tenue par Baptiste,
                                et la pâtisserie <strong>Un monde de pâtisserie</strong> de Myriam.
                                Ils proposent en dépôt-vente les t-shirts et mugs TDBR que j'ai créés
                                spécialement pour eux.
                            </p>
                            <p class="text-gray-500 text-sm italic border-l-2 border-primary/30 pl-3">
                                Myriam est ma sœur et Baptiste mon beau-frère.
                                Un grand merci à eux pour leur confiance et leur soutien depuis le début de l'aventure TDBR !
                            </p>

                            {# Photos #}
                            <div class="mt-5 grid grid-cols-2 gap-3">
                                <figure>
                                    <img src="{{ asset('uploads/general/fromage_dessert.jpg') }}"
                                         alt="La boutique Du fromage au dessert"
                                         class="w-full h-40 object-cover rounded-xl border border-gray-200">
                                    <figcaption class="text-xs text-gray-500 mt-1 text-center">La boutique</figcaption>
                                </figure>
                                <figure>
                                    <img src="{{ asset('uploads/general/baptiste.jpg') }}"
                                         alt="Baptiste, fromager"
                                         class="w-full h-40 object-cover rounded-xl border border-gray-200">
                                    <figcaption class="text-xs text-gray-500 mt-1 text-center">Baptiste, fromager</figcaption>
                                </figure>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            {# Navigation #}
            <div class="mt-16 flex flex-col sm:flex-row gap-4 justify-between">
                <a href="{{ path('presentation_workflow') }}" class="btn-outline px-6 py-3 flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                    Ma façon de travailler
                </a>
                <a href="{{ path('presentation_livraison') }}" class="btn-primary px-6 py-3 flex items-center gap-2">
                    La livraison
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </div>
    </div>
{% endblock %}
