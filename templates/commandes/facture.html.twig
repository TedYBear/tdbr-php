<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Facture {{ commande.numero }} — TDBR</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Helvetica Neue', Arial, sans-serif;
            font-size: 12px;
            color: #1a1a1a;
            background: #f0f0f0;
            line-height: 1.4;
        }

        /* Barre d'action — masquée à l'impression */
        .print-bar {
            background: #111827;
            color: #fff;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .print-bar span { font-size: 0.875rem; opacity: 0.8; }
        .print-btn {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: #fff;
            color: #111827;
            border: none;
            padding: 0.5rem 1.25rem;
            border-radius: 0.5rem;
            font-weight: 700;
            font-size: 0.875rem;
            cursor: pointer;
        }
        .back-link {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }
        .back-link:hover { color: #fff; }

        /* Page A4 */
        .page {
            max-width: 210mm;
            min-height: 297mm;
            margin: 2rem auto;
            background: #fff;
            padding: 12mm 15mm 10mm 15mm;
            box-shadow: 0 4px 24px rgba(0,0,0,0.12);
            display: flex;
            flex-direction: column;
        }

        /* En-tête */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 6mm;
            border-bottom: 2px solid #1a1a1a;
            margin-bottom: 6mm;
        }
        .brand-logo {
            height: 60px;
            width: auto;
            display: block;
            margin-bottom: 4px;
        }
        .brand-tagline {
            font-size: 10px;
            color: #666;
            margin-top: 2px;
        }
        .brand-info {
            font-size: 10px;
            color: #555;
            margin-top: 4px;
            line-height: 1.5;
        }
        .invoice-meta {
            text-align: right;
        }
        .invoice-label {
            font-size: 22px;
            font-weight: 800;
            color: #1a1a1a;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .invoice-number {
            font-size: 13px;
            font-weight: 700;
            color: #555;
            margin-top: 3px;
        }
        .invoice-date {
            font-size: 11px;
            color: #777;
            margin-top: 2px;
        }

        /* Badge statut payé */
        .paid-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #dcfce7;
            color: #15803d;
            font-weight: 700;
            font-size: 10px;
            padding: 2px 7px;
            border-radius: 12px;
            margin-top: 4px;
        }

        /* Bloc adresses */
        .addresses {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5mm;
            margin-bottom: 6mm;
        }
        .address-block {
            padding: 4mm;
            background: #f8f8f8;
            border-radius: 4px;
        }
        .address-label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #999;
            margin-bottom: 2mm;
        }
        .address-name {
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 1mm;
        }
        .address-detail {
            font-size: 11px;
            color: #555;
            line-height: 1.5;
        }

        /* Tableau articles */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5mm;
        }
        thead tr {
            background: #1a1a1a;
            color: #fff;
        }
        thead th {
            padding: 2.5mm 3.5mm;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        thead th:first-child { text-align: left; border-radius: 3px 0 0 3px; }
        thead th:last-child  { text-align: right; border-radius: 0 3px 3px 0; }
        thead th.right { text-align: right; }
        thead th.center { text-align: center; }

        tbody tr { border-bottom: 1px solid #e5e5e5; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:nth-child(even) { background: #fafafa; }
        tbody td { padding: 2.5mm 3.5mm; font-size: 11px; vertical-align: top; }
        tbody td.right { text-align: right; }
        tbody td.center { text-align: center; }
        .item-name { font-weight: 600; }
        .item-variant { font-size: 10px; color: #777; margin-top: 1px; }

        /* Totaux */
        .totals {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 5mm;
        }
        .totals-box {
            width: 58mm;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 1.2mm 0;
            font-size: 11px;
            border-bottom: 1px solid #eee;
        }
        .total-row:last-child { border-bottom: none; }
        .total-row.discount { color: #15803d; font-weight: 600; }
        .total-row.grand {
            padding: 2.5mm 0 0;
            font-size: 14px;
            font-weight: 900;
            border-top: 2px solid #1a1a1a;
            margin-top: 1mm;
        }
        .total-label { color: #555; }
        .total-label.grand { color: #1a1a1a; }
        .total-value { font-weight: 700; }

        /* Bande récap paiement + livraison */
        .meta-row {
            display: flex;
            gap: 4mm;
            margin-bottom: 5mm;
        }
        .meta-cell {
            flex: 1;
            background: #f8f8f8;
            border-radius: 4px;
            padding: 3mm 4mm;
            font-size: 11px;
        }
        .meta-cell strong {
            display: block;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #999;
            margin-bottom: 1.5mm;
        }

        /* Notes */
        .notes-block {
            font-size: 11px;
            color: #555;
            margin-bottom: 5mm;
            padding: 3mm 4mm;
            border: 1px solid #e5e5e5;
            border-radius: 4px;
        }
        .notes-block strong { color: #1a1a1a; }

        /* Footer */
        .footer {
            margin-top: auto;
            padding-top: 5mm;
            border-top: 1px solid #ddd;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            font-size: 9px;
            color: #999;
        }
        .footer-thanks {
            font-size: 12px;
            font-weight: 700;
            color: #1a1a1a;
            margin-bottom: 1mm;
        }
        .footer-legal { line-height: 1.5; }

        /* Print */
        @media print {
            body { background: white; }
            .print-bar { display: none !important; }
            .page {
                margin: 0;
                padding: 10mm 13mm 8mm 13mm;
                box-shadow: none;
                min-height: auto;
            }
            @page { size: A4; margin: 0; }
        }
    </style>
</head>
<body>

    {# Barre d'action (masquée à l'impression et en mode PDF) #}
    {% if not (pdf ?? false) %}
    <div class="print-bar">
        <a href="javascript:history.back()" class="back-link">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
            Retour
        </a>
        <span>Facture {{ commande.numero }}</span>
        <button class="print-btn" onclick="window.print()">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
            Imprimer / Sauvegarder PDF
        </button>
    </div>
    {% endif %}

    {# Page facture #}
    <div class="page">

        {# En-tête #}
        <div class="header">
            <div>
                {% if (pdf ?? false) and logoBase64 is defined and logoBase64 %}
                    <img src="{{ logoBase64 }}" alt="TDBR" class="brand-logo">
                {% else %}
                    <img src="{{ asset('build/images/TDBR.png') }}" alt="TDBR" class="brand-logo">
                {% endif %}
                <div class="brand-tagline">Créations de produits personnalisés</div>
                <div class="brand-info">
                    <strong>Emmanuel Chauveau</strong><br>
                    39 Boulevard Victor Hugo, Rés. Léopoldine B36<br>
                    31770 Colomiers, France<br>
                    tedybear.fr &nbsp;·&nbsp; SIREN : 538 044 231
                </div>
            </div>
            <div class="invoice-meta">
                <div class="invoice-label">Facture</div>
                <div class="invoice-number">N° {{ commande.numero }}</div>
                <div class="invoice-date">Date : {{ commande.createdAt|date('d/m/Y') }}</div>
                <div class="paid-badge">
                    <svg width="9" height="9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    Acquittée
                </div>
            </div>
        </div>

        {# Adresses #}
        <div class="addresses">
            <div class="address-block">
                <div class="address-label">Facturer à</div>
                <div class="address-name">{{ (commande.client.prenom ?? '') ~ ' ' ~ (commande.client.nom ?? '') }}</div>
                <div class="address-detail">
                    {{ commande.client.email }}<br>
                    {% if commande.client.telephone is defined and commande.client.telephone %}{{ commande.client.telephone }}{% endif %}
                </div>
            </div>
            <div class="address-block">
                <div class="address-label">Livrer à</div>
                {% set livraison = commande.modeLivraison %}
                {% if livraison and livraison.mode is defined and livraison.mode == 'relais' %}
                    <div class="address-name">Point relais</div>
                    <div class="address-detail">
                        {{ livraison.pointRelaisNom ?? '' }}<br>
                        {{ livraison.pointRelaisAdresse ?? '' }}
                    </div>
                {% else %}
                    {% set adresse = commande.adresseLivraison %}
                    <div class="address-name">{{ (commande.client.prenom ?? '') ~ ' ' ~ (commande.client.nom ?? '') }}</div>
                    <div class="address-detail">
                        {{ adresse.adresse ?? '' }}<br>
                        {% if adresse.complementAdresse is defined and adresse.complementAdresse %}{{ adresse.complementAdresse }}<br>{% endif %}
                        {{ adresse.codePostal ?? '' }} {{ adresse.ville ?? '' }}<br>
                        {{ (adresse.pays ?? 'FR') == 'FR' ? 'France' : (adresse.pays ?? '') }}
                    </div>
                {% endif %}
            </div>
        </div>

        {# Tableau des articles #}
        {% set sousTotal = 0 %}
        <table>
            <thead>
                <tr>
                    <th>Désignation</th>
                    <th class="center">Qté</th>
                    <th class="right">Prix unit. TTC</th>
                    <th class="right">Sous-total</th>
                </tr>
            </thead>
            <tbody>
                {% for item in commande.articles %}
                    {% set ligneTotal = item.prix * item.quantity %}
                    {% set sousTotal = sousTotal + ligneTotal %}
                    <tr>
                        <td>
                            <div class="item-name">{{ item.nom }}</div>
                            {% if item.variant is defined and item.variant %}
                                <div class="item-variant">Variante : {{ item.variant.nom }}</div>
                            {% endif %}
                            {% if item.choices is defined and item.choices|length > 0 %}
                                {% for key, val in item.choices %}
                                    <div class="item-variant">{{ key }} : {{ val }}</div>
                                {% endfor %}
                            {% endif %}
                        </td>
                        <td class="center">{{ item.quantity }}</td>
                        <td class="right">{{ item.prix|number_format(2, ',', ' ') }} €</td>
                        <td class="right">{{ ligneTotal|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        {# Totaux #}
        {% set fraisLivraison = commande.total - sousTotal + commande.reduction %}
        <div class="totals">
            <div class="totals-box">
                <div class="total-row">
                    <span class="total-label">Articles</span>
                    <span class="total-value">{{ sousTotal|number_format(2, ',', ' ') }} €</span>
                </div>
                {% if commande.reduction > 0 %}
                    <div class="total-row discount">
                        <span>Réduction</span>
                        <span>- {{ commande.reduction|number_format(2, ',', ' ') }} €</span>
                    </div>
                {% endif %}
                <div class="total-row">
                    <span class="total-label">Livraison</span>
                    <span class="total-value">
                        {% if fraisLivraison <= 0 %}Gratuite{% else %}{{ fraisLivraison|number_format(2, ',', ' ') }} €{% endif %}
                    </span>
                </div>
                <div class="total-row grand">
                    <span class="total-label grand">Total TTC</span>
                    <span>{{ commande.total|number_format(2, ',', ' ') }} €</span>
                </div>
            </div>
        </div>

        {# Bande paiement + livraison #}
        <div class="meta-row">
            <div class="meta-cell">
                <strong>Mode de paiement</strong>
                {% if commande.modePaiement == 'mollie' %}Carte bancaire
                {% elseif commande.modePaiement == 'virement' %}Virement bancaire
                {% elseif commande.modePaiement == 'paypal' %}PayPal
                {% elseif commande.modePaiement == 'admin' %}Manuel (admin)
                {% else %}{{ commande.modePaiement|capitalize }}{% endif %}
            </div>
            {% if commande.modeLivraison %}
            <div class="meta-cell">
                <strong>Mode de livraison</strong>
                {{ commande.modeLivraison.label ?? commande.modeLivraison.mode ?? '' }}
            </div>
            {% endif %}
        </div>

        {# Notes #}
        {% if commande.notes %}
            <div class="notes-block">
                <strong>Notes :</strong> {{ commande.notes }}
            </div>
        {% endif %}

        {# Footer #}
        <div class="footer">
            <div>
                <div class="footer-thanks">Merci pour votre commande !</div>
                <div class="footer-legal">
                    TDBR – Emmanuel Chauveau · 39 Bd Victor Hugo, Rés. Léopoldine B36, 31770 Colomiers<br>
                    tedybear.fr · SIREN : 538 044 231 · TVA non applicable – Art. 293 B du CGI<br>
                    Pour toute question : formulaire de contact sur tedybear.fr
                </div>
            </div>
            <div class="footer-legal" style="text-align:right; white-space:nowrap;">
                Document généré le {{ "now"|date("d/m/Y") }}<br>
                Commande du {{ commande.createdAt|date('d/m/Y') }}
            </div>
        </div>

    </div>

</body>
</html>
