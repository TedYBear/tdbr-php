<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon dépôt-vente{% endblock %} — TDBR</title>
    {% for href in encore_entry('app', 'css') %}
        <link rel="stylesheet" href="{{ href }}">
    {% endfor %}
    <style>[x-cloak]{display:none!important}</style>
</head>
<body class="bg-gray-50 min-h-screen" x-data>

    <header class="bg-white border-b border-gray-200 sticky top-0 z-10">
        <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="font-black text-lg tracking-widest text-gray-900">TDBR</span>
                <span class="text-gray-300">|</span>
                <span class="text-sm font-semibold text-gray-600">Espace dépôt-vente</span>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-sm text-gray-500 hidden sm:inline">
                    {{ app.user.prenom }} {{ app.user.nom }}
                </span>
                <a href="{{ path('logout') }}"
                   class="text-sm font-medium text-gray-500 hover:text-gray-800 transition">
                    Déconnexion
                </a>
            </div>
        </div>
    </header>

    {% include 'layout/flash_messages.html.twig' %}

    <main class="max-w-4xl mx-auto px-4 py-8">
        {% block body %}{% endblock %}
    </main>

    {% for src in encore_entry('app', 'js') %}
        <script src="{{ src }}" nonce="{{ csp_nonce() }}"></script>
    {% endfor %}
</body>
</html>
