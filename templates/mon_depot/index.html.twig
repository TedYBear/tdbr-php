{% extends 'mon_depot/base.html.twig' %}
{% block title %}{{ depot.nom }}{% endblock %}

{% block body %}
<div x-data="{ tab: 'stock', openFond: false, fondSens: 'ajout' }">

    {# ── En-tête ─────────────────────────────────────────────────────────── #}
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900">{{ depot.nom }}</h1>
        {% if depot.ville %}
            <p class="text-sm text-gray-500 mt-0.5">{{ depot.codePostal }} {{ depot.ville }}</p>
        {% endif %}
    </div>

    {# ── KPI ─────────────────────────────────────────────────────────────── #}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <div class="flex items-center justify-between mb-2">
                <p class="text-sm text-gray-500">Fond de caisse</p>
                <button @click="openFond = true; fondSens = 'ajout'"
                        class="text-xs font-semibold px-2 py-1 rounded bg-gray-100 text-gray-600 hover:bg-gray-200 transition">
                    Ajuster
                </button>
            </div>
            <p class="text-3xl font-bold text-gray-900">{{ depot.fondDeCaisse|number_format(2, ',', ' ') }} €</p>
        </div>

        <div class="bg-white rounded-xl border border-gray-200 p-5">
            <p class="text-sm text-gray-500 mb-2">Articles en stock</p>
            <p class="text-3xl font-bold text-gray-900">{{ depot.totalStock }}</p>
        </div>
    </div>

    {# ── Modal fond de caisse ─────────────────────────────────────────────── #}
    <div x-show="openFond" x-cloak
         style="position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.5);display:flex;align-items:center;justify-content:center;padding:1rem;"
         @click.self="openFond = false">
        <div class="bg-white rounded-2xl p-6 w-full max-w-sm shadow-xl">
            <h3 class="font-bold text-gray-900 mb-4">Ajustement du fond de caisse</h3>
            <form method="post" action="{{ path('mon_depot_fond') }}" class="space-y-4">
                <div class="flex gap-3">
                    <label class="flex-1 flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="sens" value="ajout" x-model="fondSens" class="text-primary">
                        <span class="text-sm font-medium">Ajout</span>
                    </label>
                    <label class="flex-1 flex items-center gap-2 cursor-pointer">
                        <input type="radio" name="sens" value="retrait" x-model="fondSens" class="text-primary">
                        <span class="text-sm font-medium">Retrait</span>
                    </label>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Montant (€)</label>
                    <input type="number" name="montant" step="0.01" min="0.01" required
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Note (optionnel)</label>
                    <input type="text" name="note"
                           class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50">
                </div>
                <div class="flex gap-3 pt-2">
                    <button type="button" @click="openFond = false"
                            class="flex-1 py-2 rounded-lg border border-gray-300 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition">
                        Annuler
                    </button>
                    <button type="submit"
                            class="flex-1 py-2 rounded-lg text-sm font-semibold text-white transition"
                            :class="fondSens === 'retrait' ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700'">
                        Valider
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# ── Onglets ──────────────────────────────────────────────────────────── #}
    <div class="flex gap-1 border-b border-gray-200 mb-6">
        <button @click="tab = 'stock'"
                :class="tab === 'stock' ? 'border-b-2 border-gray-900 text-gray-900 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                class="px-4 py-2 text-sm transition">
            Stock
        </button>
        <button @click="tab = 'vente'"
                :class="tab === 'vente' ? 'border-b-2 border-gray-900 text-gray-900 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                class="px-4 py-2 text-sm transition">
            Saisir une vente
        </button>
        <button @click="tab = 'historique'"
                :class="tab === 'historique' ? 'border-b-2 border-gray-900 text-gray-900 font-semibold' : 'text-gray-500 hover:text-gray-700'"
                class="px-4 py-2 text-sm transition">
            Historique
        </button>
    </div>

    {# ── Tab : Stock ──────────────────────────────────────────────────────── #}
    <div x-show="tab === 'stock'">
        {% if stockItems is empty %}
            <p class="text-sm text-gray-400 italic">Aucun article en stock pour le moment.</p>
        {% else %}
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
                <table class="w-full text-sm">
                    <thead class="bg-gray-50 border-b border-gray-200">
                        <tr>
                            <th class="px-4 py-3 text-left font-semibold text-gray-600">Article</th>
                            <th class="px-4 py-3 text-left font-semibold text-gray-600">Variante</th>
                            <th class="px-4 py-3 text-right font-semibold text-gray-600">Qté</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for item in stockItems %}
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-4 py-3 font-medium text-gray-900">
                                    {{ item.variante.article.nom }}
                                </td>
                                <td class="px-4 py-3 text-gray-600">{{ item.variante.nom }}</td>
                                <td class="px-4 py-3 text-right font-bold text-gray-900">{{ item.quantite }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    {# ── Tab : Vente ──────────────────────────────────────────────────────── #}
    <div x-show="tab === 'vente'" x-cloak>
        {% if stockItems is empty %}
            <p class="text-sm text-gray-400 italic">Aucun article en stock à vendre.</p>
        {% else %}
            <form method="post" action="{{ path('mon_depot_vente') }}">
                <div class="bg-white rounded-xl border border-gray-200 overflow-hidden mb-4">
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-left font-semibold text-gray-600">Article / Variante</th>
                                <th class="px-4 py-3 text-right font-semibold text-gray-600 w-20">Stock</th>
                                <th class="px-4 py-3 text-center font-semibold text-gray-600 w-24">Qté vendue</th>
                                <th class="px-4 py-3 text-center font-semibold text-gray-600 w-28">Prix unitaire (€)</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for item in stockItems %}
                                <tr class="hover:bg-gray-50 transition">
                                    <td class="px-4 py-3">
                                        <div class="font-medium text-gray-900">{{ item.variante.article.nom }}</div>
                                        <div class="text-xs text-gray-500">{{ item.variante.nom }}</div>
                                    </td>
                                    <td class="px-4 py-3 text-right text-gray-600">{{ item.quantite }}</td>
                                    <td class="px-4 py-3 text-center">
                                        <input type="number" name="lignes[{{ item.id }}][qty]"
                                               min="0" max="{{ item.quantite }}" value="0"
                                               class="w-20 border border-gray-300 rounded-lg px-2 py-1 text-center text-sm focus:outline-none focus:ring-2 focus:ring-primary/50">
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        <input type="number" name="lignes[{{ item.id }}][prixReel]"
                                               min="0" step="0.01" placeholder="0.00"
                                               class="w-24 border border-gray-300 rounded-lg px-2 py-1 text-center text-sm focus:outline-none focus:ring-2 focus:ring-primary/50">
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="flex items-end gap-4">
                    <div class="flex-1">
                        <label class="block text-sm font-medium text-gray-700 mb-1">Note (optionnel)</label>
                        <input type="text" name="note" placeholder="ex : vente du samedi"
                               class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/50">
                    </div>
                    <button type="submit"
                            class="px-5 py-2 rounded-lg bg-gray-900 text-white text-sm font-semibold hover:bg-gray-700 transition">
                        Enregistrer la vente
                    </button>
                </div>
            </form>
        {% endif %}
    </div>

    {# ── Tab : Historique ─────────────────────────────────────────────────── #}
    <div x-show="tab === 'historique'" x-cloak>
        {% if transactions is empty %}
            <p class="text-sm text-gray-400 italic">Aucune transaction enregistrée.</p>
        {% else %}
            <div class="space-y-3">
                {% for tx in transactions %}
                    <div class="bg-white rounded-xl border border-gray-200 p-4">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-full mb-1
                                    {% if tx.type == 'vente' %}bg-green-100 text-green-700
                                    {% elseif tx.type == 'reassort' %}bg-blue-100 text-blue-700
                                    {% else %}bg-gray-100 text-gray-600{% endif %}">
                                    {{ tx.typeLabel }}
                                </span>
                                {% if tx.note %}
                                    <p class="text-sm text-gray-600">{{ tx.note }}</p>
                                {% endif %}
                                {% if tx.lignes|length > 0 %}
                                    <ul class="mt-1 space-y-0.5">
                                        {% for ligne in tx.lignes %}
                                            <li class="text-xs text-gray-500">
                                                {{ ligne.varianteLabel }} × {{ ligne.quantite|abs }}
                                                {% if ligne.prixReel %}— {{ ligne.prixReel|number_format(2, ',', ' ') }} €{% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                            <div class="text-right shrink-0">
                                {% if tx.montantFond is not null %}
                                    <p class="text-sm font-bold {{ tx.montantFond >= 0 ? 'text-green-600' : 'text-red-600' }}">
                                        {{ tx.montantFond >= 0 ? '+' : '' }}{{ tx.montantFond|number_format(2, ',', ' ') }} €
                                    </p>
                                {% endif %}
                                <p class="text-xs text-gray-400 mt-0.5">{{ tx.createdAt|date('d/m/Y H:i') }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
