# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET="ChangeMe! Generate with: php -r \"echo bin2hex(random_bytes(16));\""
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Paramètres séparés pour éviter les problèmes d'encodage URL avec les mots de passe spéciaux
# À surcharger dans .env.local (dev) ou via variables d'environnement (prod)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app
DB_USER=app
DB_PASSWORD=!ChangeMe!
DB_VERSION=8.0
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
# IMPORTANT: Configurer MAILER_DSN dans .env.local ou via variables d'environnement
# Ex: MAILER_DSN=smtp://user%40gmail.com:password@smtp.gmail.com:587
MAILER_DSN=null://null
MAILER_FROM=boutique.tdbr@gmail.com
MAILER_BCC=tdbrlaboutique@gmail.com
###< symfony/mailer ###

###> Upload Configuration ###
UPLOAD_DIR=%kernel.project_dir%/public/uploads
MAX_UPLOAD_SIZE=5242880
###< Upload Configuration ###

###> mollie ###
# Remplacer par votre clé dans .env.local (ne jamais committer la vraie clé)
# Test : test_xxx | Live : live_xxx
MOLLIE_API_KEY=test_your_mollie_key_here
###< mollie ###

###> Printful ###
# Clé API et Store ID Printful — à surcharger dans .env.local
# Store ID : Printful → Settings → Stores → votre boutique
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
###< Printful ###
