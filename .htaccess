<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Forcer HTTPS et non-www sur l'URI d'origine, AVANT la réécriture vers /public.
    # Sinon la redirection se déclenche depuis public/.htaccess une fois l'URI déjà
    # réécrite en /public/index.php, et exposerait ce chemin interne dans le Location.
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

    # Éviter la boucle infinie si déjà dans /public
    RewriteCond %{REQUEST_URI} ^/public/ [OR]
    RewriteCond %{REQUEST_URI} ^/public$
    RewriteRule ^ - [L]

    # Servir les assets statiques existants dans public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Tout le reste → index.php de Symfony
    RewriteRule ^ public/index.php [L]
</IfModule>
